{
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/mcp/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/widget/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mcp/:key",
      "destination": "/api/mcp?key=:key"
    },
    {
      "source": "/widget/:key",
      "destination": "/api/widget?key=:key"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/|mcp/|widget/).*)",
      "has": [
        {
          "type": "host",
          "value": "threads-dun-two.vercel.app"
        }
      ],
      "destination": "https://threads.zerogee.dev/:path",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/live",
      "schedule": "17 8 * * *"
    }
  ]
}
